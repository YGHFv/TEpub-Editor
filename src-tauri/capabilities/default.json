{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力。fs 插件不再静态放行 ** 全盘：前端直接的 fs 调用只覆盖 $APPDATA（书库默认根、mobile 导入缓存）；用户经保存/打开对话框选中的路径由 dialog 插件在运行时自动授权；后端导出到公共下载目录的文件由 mobile_export_epub 运行时补授权。其余文件访问一律走后端 invoke（不受插件 scope 限制）。",
  "windows": [
    "main",
    "editor-*",
    "epub-editor-*",
    "epub-metadata",
    "reader-*",
    "search-replace",
    "toolbox",
    "image-tools-*",
    "batch-progress-*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-decorated",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:event:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "core:resources:default",
    "core:path:default",
    "core:webview:default"
  ]
}
